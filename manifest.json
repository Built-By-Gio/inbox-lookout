{
  "manifest_version": 3,
  "name": "Inbox Lookout",
  "version": "1.0.0",
  "description": "Reads your Gmail in the background, hides the junk and tells you what needs you. Learns from what you open and what you skip.",
  "permissions": ["alarms", "storage", "notifications", "offscreen", "background"],
  "host_permissions": ["https://mail.google.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Inbox Lookout",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
